# Development environment configuration
# This file is used locally and should NOT be committed to production

# Environment type: controls robots meta tags and indexing behavior
# - development: robots meta = "noindex, nofollow" (prevent indexing)
# - preview: robots meta = "noindex, nofollow" (prevent indexing)
# - production: robots meta = "index, follow" (allow indexing) — ONLY when live
ENVIRONMENT=development

# Vercel uses this variable automatically in preview deployments
# It will be automatically set to "preview" in Vercel preview environments
# and "production" in production — you don't need to set it manually
