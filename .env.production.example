# Production environment configuration template
#
# IMPORTANT: This is an EXAMPLE template showing the structure.
# DO NOT activate this yet — the site is not live on its production domain.
#
# When Theme Your Dream domain is live and ready for search engine indexing:
# 1. Create .env.production in Vercel project settings (NOT in the repo)
# 2. Set ENVIRONMENT=production
# 3. Verify robots meta is updated to "index, follow"
# 4. Test that canonical tags point to production domain
# 5. Submit sitemap to Google Search Console
#
# To set in Vercel:
# - Go to Project Settings → Environment Variables
# - Add: ENVIRONMENT = production (for production deployment only)
# - Leave preview deployments at ENVIRONMENT = preview (default)

ENVIRONMENT=production
